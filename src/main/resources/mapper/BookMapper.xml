<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- namespace 必须和Mapper接口全类名完全一致 -->
<mapper namespace="com.bookstore.mapper.BookMapper">

    <select id="getBookList" resultType="com.bookstore.entity.Book">
        SELECT
            id,
            book_name,
            author,
            word_count,
            price,
            category,
            book_img,
            book_desc,
            press,
            publish_date,
            create_time,
            update_time
        FROM book
    </select>

</mapper>
